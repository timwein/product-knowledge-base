# Sentinel curator — local dev env vars. Copy to .env and fill in.

# Postgres
DATABASE_URL=postgres://sentinel:sentinel_dev@localhost:5432/sentinel

# Anthropic API (fresh key for Sentinel; not Tim's personal key)
ANTHROPIC_API_KEY=sk-ant-...

# Clerk (for verifying user JWTs on internal endpoints)
CLERK_SECRET_KEY=sk_test_...

# Shared HMAC secret between web and curator
INTERNAL_HMAC_SECRET=

# Managed Agent identifiers (populated by setup.py once Sentinel agent exists)
AGENT_ID=
AGENT_VERSION=
ENV_ID=

# Shared staging git repo for agent outputs
STAGING_REPO_URL=
STAGING_REPO_TOKEN=
